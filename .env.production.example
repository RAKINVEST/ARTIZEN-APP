# ARTIZEN — production environment (T3 topology). Reference for the variables to
# set on the Scalingo backend app. NOT a file to commit filled in: set these as
# Scalingo env vars (scalingo --app <app> env-set KEY=value). The app refuses to
# boot if a selected provider is left unconfigured (see app/core/config.py).

# --- Application ---
# MANDATORY. Unlocks the production guards (strong SECRET_KEY, no DEBUG, no
# wildcard CORS, no /docs). Miss it and those safety nets silently disappear.
ENVIRONMENT=production
DEBUG=false

# --- Security / JWT ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Must be >= 32 chars and never the placeholder — the app refuses to boot otherwise.
SECRET_KEY=

# --- Database (managed Postgres addon) ---
# Set to the addon's connection URL. On Scalingo: the value of SCALINGO_POSTGRESQL_URL.
# Wins over the POSTGRES_* parts; scheme is normalised to asyncpg automatically.
DATABASE_URL_OVERRIDE=

# --- CORS / links ---
# The EXACT frontend origin (the static CDN domain). Wildcard is refused in prod.
CORS_ORIGINS=https://app.artizen.fr
# Public web-app URL, used to build password-reset links in emails.
APP_BASE_URL=https://app.artizen.fr

# --- Rate limiting ---
# "redis" shares the counter across workers/replicas (needs the Redis addon).
RATE_LIMIT_BACKEND=redis
REDIS_URL=

# --- Storage (S3-compatible object storage, EU) ---
# The container filesystem is ephemeral on a PaaS — "s3" is mandatory in prod.
STORAGE_PROVIDER=s3
STORAGE_S3_ENDPOINT_URL=
STORAGE_S3_REGION=
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=

# --- Email (Brevo SMTP) ---
EMAIL_PROVIDER=smtp
EMAIL_FROM=no-reply@artizen.fr
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# --- Support ---
# The real, monitored contact address (single source: Paramètres + legal pages).
SUPPORT_EMAIL=support@artizen.fr

# --- RGPD retention (optional) ---
# Leave UNSET until the legal policy fixes a duration: the purge is a strict no-op
# by default. When set, accounts inactive for that many days are erased.
# RETENTION_INACTIVE_ACCOUNT_DAYS=

# --- Server tuning (optional) ---
# WEB_CONCURRENCY=4   # uvicorn workers; $PORT is injected by the platform.
