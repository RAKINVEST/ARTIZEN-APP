# Copy this file to ".env" and adjust values before running docker compose up.

# --- Application ---
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api
CORS_ORIGINS=http://localhost:3000

# --- Logging ---
LOG_LEVEL=INFO

# --- Database ---
# POSTGRES_HOST is overridden to "db" by docker-compose.yml automatically;
# set it to "localhost" only if you run the backend outside Docker.
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=artizen
POSTGRES_PASSWORD=change_me
POSTGRES_DB=artizen

# --- Security / JWT ---
# The value below is a PLACEHOLDER and is public knowledge: anyone holding
# it can forge a JWT for any user of any company. The app refuses to start
# with it when ENVIRONMENT=production (see app/core/config.py); generate a
# real one before deploying:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change_me_super_secret_key
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Rate limiting (app/core/rate_limit.py) ---
# Applies to POST /auth/login and POST /auth/register only — the sole
# routes reachable without a token. Turn it off ONLY for tests: it is what
# keeps the user base from being enumerable. Note the counter lives in each
# worker's memory, so with the production CMD's 4 workers the real ceiling
# is roughly 4x the value below.
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_MAX_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# --- AI Providers (abstraction layer) ---
# None of these keys are required to run, develop, test, or demo Artizen:
# if the key for DEFAULT_AI_PROVIDER is missing, app/ai/factory.py falls
# back automatically to MockAIProvider (fully offline, deterministic).
# Add a real key later and just restart the backend to switch to the
# real provider — no code change needed anywhere.
DEFAULT_AI_PROVIDER=anthropic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=

# --- Storage (abstraction layer, see app/branding/storage.py) ---
# STORAGE_LOCAL_ROOT is a path inside the backend container, persisted via
# the artizen_storage_data volume. Only change it to "local" alternatives
# would require adding a new StorageProvider implementation.
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=/data/storage
