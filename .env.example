# Copy this file to ".env" and adjust values before running docker compose up.

# --- Application ---
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api
CORS_ORIGINS=http://localhost:3000

# --- Logging ---
LOG_LEVEL=INFO

# --- Database ---
# POSTGRES_HOST is overridden to "db" by docker-compose.yml automatically;
# set it to "localhost" only if you run the backend outside Docker.
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=artizen
POSTGRES_PASSWORD=change_me
POSTGRES_DB=artizen

# --- Security / JWT ---
SECRET_KEY=change_me_super_secret_key
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- AI Providers (abstraction layer) ---
# None of these keys are required to run, develop, test, or demo Artizen:
# if the key for DEFAULT_AI_PROVIDER is missing, app/ai/factory.py falls
# back automatically to MockAIProvider (fully offline, deterministic).
# Add a real key later and just restart the backend to switch to the
# real provider — no code change needed anywhere.
DEFAULT_AI_PROVIDER=anthropic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=

# --- Storage (abstraction layer, see app/branding/storage.py) ---
# STORAGE_LOCAL_ROOT is a path inside the backend container, persisted via
# the artizen_storage_data volume. Only change it to "local" alternatives
# would require adding a new StorageProvider implementation.
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=/data/storage
